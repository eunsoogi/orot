{
  "name": "@orot/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:pods": "pod install --project-directory=ios",
    "ios:build": "pnpm run ios:pods && xcodebuild -workspace ios/OrotMobile.xcworkspace -scheme OrotMobile -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "test": "pnpm run test:unit",
    "test:unit": "jest --config jest.config.js --runInBand --testPathIgnorePatterns=/e2e/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e:build:ios": "pnpm run ios:pods && detox build --configuration ios.sim.release",
    "e2e:build:ios:agent-memory": "detox build --config-path ./e2e/agent-memory.detox.config.js --configuration ios.sim.release.agent-memory",
    "e2e:test:ios": "detox test --configuration ios.sim.release",
    "e2e:test:ios:agent-memory": "detox test --config-path ./e2e/agent-memory.detox.config.js --configuration ios.sim.release.agent-memory",
    "e2e:build:ios:graph": "detox build --config-path ./e2e/graph.detox.config.js --configuration ios.sim.release.graph",
    "e2e:test:ios:graph": "detox test --config-path ./e2e/graph.detox.config.js --configuration ios.sim.release.graph",
    "e2e:build:ios:apple-foundation-models": "pnpm run ios:pods && test -n \"$OROT_APPLE_FOUNDATION_MODELS_SIMULATOR_UDID\" && test -n \"$OROT_APPLE_FOUNDATION_MODELS_DERIVED_DATA_PATH\" && detox build --config-path ./e2e/apple-foundation-models.detox.config.js --configuration ios.sim.release.apple-foundation-models",
    "e2e:test:ios:apple-foundation-models": "test -n \"$OROT_APPLE_FOUNDATION_MODELS_SIMULATOR_UDID\" && test -n \"$OROT_APPLE_FOUNDATION_MODELS_EVIDENCE_DIR\" && test -n \"$OROT_APPLE_FOUNDATION_MODELS_DERIVED_DATA_PATH\" && detox test --config-path ./e2e/apple-foundation-models.detox.config.js --configuration ios.sim.release.apple-foundation-models --artifacts-location \"$OROT_APPLE_FOUNDATION_MODELS_EVIDENCE_DIR\""
  },
  "dependencies": {
    "@orot/agent-memory": "workspace:*",
    "@orot/model-runtime": "workspace:*",
    "@orot/provider-apple": "workspace:*",
    "@op-engineering/op-sqlite": "18.2.5",
    "@orot/agent-runtime": "workspace:*",
    "@orot/storage": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "10.0.0",
    "web-streams-polyfill": "4.3.0"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.0",
    "detox": "20.51.4",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "test-renderer": "1.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
