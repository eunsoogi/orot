# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
                                                 'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'OrotMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # The hosted test bundle imports production native services and resolves React headers through its app host.
  target 'OrotIntegrationTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Reconcile RN's pinned artifact headers after a fresh install. Its patched
    # configuration-switch script repeats the same repair before replacing a slice.
    react_native_root = File.expand_path(config[:reactNativePath], __dir__)
    Pod::Executable.execute_command('node', [
                                      File.join(react_native_root, 'scripts/orot-prebuilt-headers.cjs'),
                                      File.join(__dir__, 'Pods/React-Core-prebuilt')
                                    ])
  end
end
