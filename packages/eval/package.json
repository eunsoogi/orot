{
  "name": "@orot/eval",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "pnpm --filter @orot/mobile exec eslint --config .eslintrc.js ../../packages/eval/src ../../packages/eval/__tests__ --ext .ts",
    "typecheck": "pnpm --filter @orot/mobile exec tsc --noEmit --project ../../packages/eval/tsconfig.json",
    "test:unit": "pnpm --filter @orot/mobile exec jest --config ../../packages/eval/jest.config.js --runInBand"
  },
  "dependencies": {
    "@orot/domain": "workspace:*"
  }
}
