index 0000000000000000000000000000000000000000..5db70de2260aaa4120d1cfc79d54519930654bfd
--- /dev/null
+++ b/ios/RNKeychainManager/RNKeychainAuthentication.h
@@ -0,0 +1,73 @@
+#import <Availability.h>
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+#import <TargetConditionals.h>
+
+#if TARGET_OS_TV || (TARGET_OS_IOS && __IPHONE_OS_VERSION_MIN_REQUIRED < 110000) || (TARGET_OS_OSX && __MAC_OS_X_VERSION_MIN_REQUIRED < 101300)
+#define RNKEYCHAIN_USE_LEGACY_AUTHENTICATION_QUERY 1
+#else
+#define RNKEYCHAIN_USE_LEGACY_AUTHENTICATION_QUERY 0
+#endif
+
+// tvOS lacks the LAContext prompt controls, and older deployment targets may
+// run before those properties exist. Orot's iOS target is 15.1, so its builds
+// compile only the modern path and retain no deprecated iOS Security keys.
+#if RNKEYCHAIN_USE_LEGACY_AUTHENTICATION_QUERY
+static inline void RNKeychainSetLegacyAuthenticationPrompt(NSMutableDictionary *query,
+                                                           NSString *prompt)
+{
+  query[(__bridge NSString *)kSecUseOperationPrompt] = prompt;
+}
+
+static inline void RNKeychainDisallowLegacyAuthenticationUI(NSMutableDictionary *query)
+{
+  query[(__bridge NSString *)kSecUseAuthenticationUI] = (__bridge NSString *)kSecUseAuthenticationUIFail;
+}
+#endif
+
+// Each query receives a fresh context; do not reuse authentication across queries.
+static inline void RNKeychainSetAuthenticationPrompt(NSMutableDictionary *query,
+                                                    NSString *prompt)
+{
+#if TARGET_OS_TV
+  RNKeychainSetLegacyAuthenticationPrompt(query, prompt);
+#elif RNKEYCHAIN_USE_LEGACY_AUTHENTICATION_QUERY
+  if (@available(iOS 11, macOS 10.13, *)) {
+    LAContext *context = [LAContext new];
+    context.localizedReason = prompt;
+    query[(__bridge NSString *)kSecUseAuthenticationContext] = context;
+  } else {
+    RNKeychainSetLegacyAuthenticationPrompt(query, prompt);
+  }
+#else
+  LAContext *context = [LAContext new];
+  context.localizedReason = prompt;
+  query[(__bridge NSString *)kSecUseAuthenticationContext] = context;
+#endif
+}
+
+static inline void RNKeychainDisallowAuthenticationUI(NSMutableDictionary *query)
+{
+#if TARGET_OS_TV
+  RNKeychainDisallowLegacyAuthenticationUI(query);
+#elif RNKEYCHAIN_USE_LEGACY_AUTHENTICATION_QUERY
+  if (@available(iOS 11, macOS 10.13, *)) {
+    LAContext *context = [LAContext new];
+    // Preserve errSecInteractionNotAllowed for checks that would otherwise
+    // require user interaction, without displaying an auth prompt.
+    context.interactionNotAllowed = YES;
+    query[(__bridge NSString *)kSecUseAuthenticationContext] = context;
+  } else {
+    RNKeychainDisallowLegacyAuthenticationUI(query);
+  }
+#else
+  LAContext *context = [LAContext new];
+  // Preserve errSecInteractionNotAllowed for checks that would otherwise
+  // require user interaction, without displaying an auth prompt.
+  context.interactionNotAllowed = YES;
+  query[(__bridge NSString *)kSecUseAuthenticationContext] = context;
+#endif
+}
+
+#undef RNKEYCHAIN_USE_LEGACY_AUTHENTICATION_QUERY
