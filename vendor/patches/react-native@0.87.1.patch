diff --git a/scripts/orot-prebuilt-headers.cjs b/scripts/orot-prebuilt-headers.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..2b0f9e244c8d1a1fa3ee432e83884d43bb7d1986
--- /dev/null
+++ b/scripts/orot-prebuilt-headers.cjs
@@ -0,0 +1,107 @@
+'use strict';
+
+// RN 0.87.1's published binary artifacts need the same declaration repairs after
+// installation and each Debug/Release swap. Compiled binaries remain untouched.
+const fs = require('node:fs');
+const path = require('node:path');
+const textualHeaders = require('./orot-textual-headers.json');
+
+function replaceDeclaration(text, before, after, label) {
+  if (text.includes(after)) return text;
+  if (text.split(before).length !== 2) {
+    throw new Error(`Unexpected React 0.87.1 header declaration: ${label}`);
+  }
+  return text.replace(before, after);
+}
+
+function repairFile(file, replacements) {
+  const original = fs.readFileSync(file, 'utf8');
+  let result = original;
+  for (const [before, after] of replacements) {
+    result = replaceDeclaration(result, before, after, file);
+  }
+  if (result !== original) writeRepairedFile(file, result);
+}
+
+function writeRepairedFile(file, contents) {
+  // CocoaPods marks copied public headers read-only. Replace our sandbox copy
+  // atomically, retaining its mode and leaving any downloaded/cache inode alone.
+  const stat = fs.lstatSync(file);
+  if (!stat.isFile()) throw new Error(`Expected a regular sandbox header: ${file}`);
+  const temporary = `${file}.orot-${process.pid}`;
+  fs.writeFileSync(temporary, contents, {flag: 'wx', mode: stat.mode & 0o777});
+  fs.renameSync(temporary, file);
+}
+
+function repairFramework(frameworkRoot) {
+  if (require('../package.json').version !== '0.87.1') {
+    throw new Error('Reassess the prebuilt declaration repairs when upgrading React Native');
+  }
+  let slices = 0;
+  for (const entry of fs.readdirSync(frameworkRoot, {withFileTypes: true})) {
+    const framework = path.join(frameworkRoot, entry.name, 'React.framework');
+    if (!entry.isDirectory() || !fs.existsSync(framework)) continue;
+    slices += 1;
+    const headers = path.join(framework, 'Headers');
+    const map = path.join(framework, 'Modules/module.modulemap');
+    const original = fs.readFileSync(map, 'utf8');
+    let result = original;
+    // These shipped headers were already outside the umbrella. Textual entries
+    // preserve explicit Objective-C/C++ includes without exporting them to Swift.
+    for (const name of textualHeaders) {
+      if (!fs.existsSync(path.join(headers, name))) throw new Error(`Missing React header: ${name}`);
+      const declaration = `  textual header "${name}"\n`;
+      if (!result.includes(declaration)) {
+        if (!result.includes('  export *\n')) throw new Error('Unexpected React module map');
+        result = result.replace('  export *\n', declaration + '  export *\n');
+      }
+    }
+    if (result !== original) writeRepairedFile(map, result);
+
+    // Explicit unspecified annotations preserve the original Swift IUO contract;
+    // they do not assert a new nonnull guarantee for callback providers.
+    repairFile(path.join(headers, 'RCTHTTPRequestHandler.h'), [
+      ['NSURLSessionConfigurationProvider /*provider*/', 'NSURLSessionConfigurationProvider _Null_unspecified /*provider*/'],
+      ['NSURLRequest *request', 'NSURLRequest *_Null_unspecified request'],
+      ['RCTHTTPRequestInterceptor /*interceptor*/', 'RCTHTTPRequestInterceptor _Null_unspecified /*interceptor*/'],
+    ]);
+    repairFile(path.join(headers, 'RCTMultipartDataTask.h'), [
+      ['NSDictionary *headers', 'NSDictionary *_Null_unspecified headers'],
+      ['NSData *content', 'NSData *_Null_unspecified content'],
+      ['NSError *error', 'NSError *_Null_unspecified error'],
+      ['NSURLRequest *request', 'NSURLRequest *_Null_unspecified request'],
+      ['RCTMultipartDataTaskRequestInterceptor /*interceptor*/', 'RCTMultipartDataTaskRequestInterceptor _Null_unspecified /*interceptor*/'],
+      ['(instancetype)initWithURL:(NSURL *)url', '(instancetype _Null_unspecified)initWithURL:(NSURL *_Null_unspecified)url'],
+      ['(RCTMultipartDataTaskCallback)partHandler', '(RCTMultipartDataTaskCallback _Null_unspecified)partHandler'],
+      ['(RCTMultipartProgressCallback)progressHandler', '(RCTMultipartProgressCallback _Null_unspecified)progressHandler'],
+    ]);
+    repairFile(path.join(headers, 'RCTWebSocketModule.h'), [
+      ['typedef SRWebSocket * (^SRWebSocketProvider)', 'typedef SRWebSocket *_Null_unspecified (^SRWebSocketProvider)'],
+    ]);
+    // NSObject's equality contract accepts nil; the override must agree.
+    repairFile(path.join(headers, 'RCTReactTaggedView.h'), [
+      ['- (BOOL)isEqual:(id)other;', '- (BOOL)isEqual:(nullable id)other;'],
+    ]);
+  }
+  if (slices === 0) throw new Error('No React framework slices were found');
+}
+
+function repairPrebuilt(podRoot) {
+  repairFramework(path.join(podRoot, 'React.xcframework'));
+  // The public selector and parameter type stay unchanged. Its declaration must
+  // carry the same deprecation as the legacy RCTRootView in that signature.
+  repairFile(path.join(podRoot, 'Headers/React_RCTAppDelegate/RCTUIConfiguratorProtocol.h'), [
+    ['- (void)customizeRootView:(RCTRootView *)rootView;', '- (void)customizeRootView:(RCTRootView *)rootView\n    __attribute__((deprecated("This compatibility hook uses the legacy RCTRootView API.")));'],
+  ]);
+  // Attribute only the three legacy overloads already documented as deprecated.
+  // The new overloads and inline implementation/ABI remain unchanged.
+  repairFile(path.join(podRoot, 'Headers/react/renderer/mounting/ShadowViewMutation.h'), [
+    ['  static ShadowViewMutation InsertMutation(const ShadowView &parentShadowView', '  [[deprecated("Pass parentTag instead of parentShadowView.")]]\n  static ShadowViewMutation InsertMutation(const ShadowView &parentShadowView'],
+    ['  static ShadowViewMutation RemoveMutation(const ShadowView &parentShadowView', '  [[deprecated("Pass parentTag instead of parentShadowView.")]]\n  static ShadowViewMutation RemoveMutation(const ShadowView &parentShadowView'],
+    ['  static ShadowViewMutation\n  UpdateMutation(ShadowView oldChildShadowView, ShadowView newChildShadowView, const ShadowView &parentShadowView)', '  [[deprecated("Pass parentTag instead of parentShadowView.")]]\n  static ShadowViewMutation\n  UpdateMutation(ShadowView oldChildShadowView, ShadowView newChildShadowView, const ShadowView &parentShadowView)'],
+  ]);
+}
+
+module.exports = {repairFramework, repairPrebuilt};
+
+if (require.main === module) repairPrebuilt(process.argv[2]);
