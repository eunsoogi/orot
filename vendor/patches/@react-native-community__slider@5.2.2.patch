new file mode 100644
index 0000000000000000000000000000000000000000..b589ddd392a300702b745eef99fd15696dfeb65b
--- /dev/null
+++ b/ios/RNCReleaseOnlyContact.hpp
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+// Raw contact owns the thumb even while UIKit's recognizer is still Possible.
+class RNCReleaseOnlyContact {
+ public:
+  enum class Motion { waiting, horizontal, vertical };
+
+  bool begin() {
+    if (active_) return false;
+    active_ = true;
+    horizontal_ = false;
+    return true;
+  }
+
+  bool ownsThumb() const { return active_; }
+  bool movedHorizontally() const { return horizontal_; }
+
+  Motion move(double dx, double dy) {
+    if (!active_) return Motion::waiting;
+    if (horizontal_) return Motion::horizontal;
+    if (std::max(std::abs(dx), std::abs(dy)) < 8) return Motion::waiting;
+    if (std::abs(dy) > std::abs(dx)) return Motion::vertical;
+    horizontal_ = true;
+    return Motion::horizontal;
+  }
+
+  // Both actual completion and cancellation consume the one contact; only the
+  // recognizer's positive terminal action is allowed to request a seek.
+  bool finish() {
+    if (!active_) return false;
+    active_ = false;
+    horizontal_ = false;
+    return true;
+  }
+
+ private:
+  bool active_{false};
+  bool horizontal_{false};
+};
