diff --git a/ios/Fabric/RNCSafeAreaProviderComponentView.mm b/ios/Fabric/RNCSafeAreaProviderComponentView.mm
--- a/ios/Fabric/RNCSafeAreaProviderComponentView.mm
+++ b/ios/Fabric/RNCSafeAreaProviderComponentView.mm
@@ -18,6 +18,7 @@
   CGRect _currentFrame;
   BOOL _initialInsetsSent;
   BOOL _registeredNotifications;
+  NSUInteger _mountGeneration;
 }

 // Needed because of this: https://github.com/facebook/react-native/pull/37274
@@ -47,6 +48,32 @@
   }
 }
 #endif
+
+#if !TARGET_OS_OSX
+// Fabric may drop the first insets event while attaching the view. Replay once
+// after mounting; stale callbacks must not affect a recycled or reparented view.
+- (void)didMoveToWindow
+{
+  [super didMoveToWindow];
+  const NSUInteger generation = ++_mountGeneration;
+  if (self.window == nil) {
+    return;
+  }
+
+  __weak RNCSafeAreaProviderComponentView *weakSelf = self;
+  __weak typeof(self.window) mountWindow = self.window;
+  __weak UIView *mountSuperview = self.superview;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    RNCSafeAreaProviderComponentView *strongSelf = weakSelf;
+    if (strongSelf == nil || strongSelf->_mountGeneration != generation || strongSelf.window == nil ||
+        strongSelf.window != mountWindow || strongSelf.superview != mountSuperview) {
+      return;
+    }
+    strongSelf->_initialInsetsSent = NO;
+    [strongSelf invalidateSafeAreaInsets];
+  });
+}
+#endif

